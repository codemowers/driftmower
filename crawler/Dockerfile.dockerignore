# Deny by default: only the crawler's build inputs enter the Docker context.
# Re-include each directory as well as its files: Skaffold does not descend
# into an excluded directory to find re-included files.
**
!go.mod
!go.sum
!crawler/cmd/
!crawler/cmd/**/*.go
!crawler/internal/
!crawler/internal/**/*.go
!crawler/internal/**/*.html
!internal/
!internal/**/*.go
!internal/**/*.html
**/*_test.go

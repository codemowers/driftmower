SKAFFOLD_KUBE_CONTEXT=<context>
SKAFFOLD_NAMESPACE=driftmower
# Batch agent edits; press Enter in skaffold dev to rebuild and deploy.
SKAFFOLD_TRIGGER=manual
# Expose Skaffold's HTTP RPC API for local tooling.
SKAFFOLD_RPC_HTTP_PORT=50052
# Copied kubectl commands use SKAFFOLD_KUBE_CONTEXT unless overridden.
# KUBECTL_CONTEXT=<context>
SKAFFOLD_DEFAULT_REPO=<registry>/<user>
# Optional: Argo CD's public address, when an Argo CD (possibly in another
# cluster) manages this cluster's workloads; enables links to its applications.
#ARGO_URL=https://<argocd host>
# Each cluster runs its own crawler and registry scraper.
# Logs and aggregate log rates come from its configured Loki service.

# MCP access policy: rbac (default), oidc (all reads after login), anonymous.
# MCP_AUTH_MODE=rbac
# MCP_INGRESS_ENABLED=true
# MCP_PUBLIC_URL=http://127.0.0.1:3000
# UI_ENABLED=true
# OPERATOR_ENABLED=true

# Cached private-image authorization: run scans beside a consuming Pod.
# SCAN_STRATEGY=workloadNamespace
# Background scanner CPU reservation (Helm: operator.trivy.cpuRequest).
# SCAN_CPU_REQUEST=100m

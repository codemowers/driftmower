# Deny by default: only application build inputs enter the Docker context.
**
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!scripts/
!scripts/build-web.mjs
!src/
!src/**/
!src/**/*.ts
!src/advisory/content/**/*.md
!config/
!config/default.json
!config/custom-environment-variables.json

# Tests and declarations generated outside the build are not image inputs.
src/**/*.test.ts
src/**/*.spec.ts
src/**/*.d.ts

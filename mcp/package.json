{
  "name": "driftmower-mcp",
  "description": "Cluster-specific Kubernetes discovery and observability through MCP",
  "keywords": [
    "mcp",
    "driftmower",
    "k8s"
  ],
  "license": "ISC",
  "author": "msergo",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "driftmower-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "npm run build:web && tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start": "node dist/index.js",
    "prettier": "prettier --write --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "format": "npm run prettier && npm run lint -- --fix",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "npm run build:web && node --import tsx test/web-ui-browser.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@prometheus-io/client": "^0.16.1",
    "commander": "^15.0.0",
    "config": "^4.0.0",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "oidc-client-ts": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/config": "^3.3.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.0"
  },
  "private": true
}

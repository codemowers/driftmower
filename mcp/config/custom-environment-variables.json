{
  "mcp": {
    "transport": "DRIFTMOWER_MCP_TRANSPORT",
    "host": "DRIFTMOWER_MCP_HOST",
    "port": {
      "__name": "DRIFTMOWER_MCP_PORT",
      "__format": "number"
    },
    "healthPort": {
      "__name": "DRIFTMOWER_MCP_HEALTH_PORT",
      "__format": "number"
    },
    "logLevel": "DRIFTMOWER_MCP_LOG_LEVEL",
    "publicUrl": "MCP_PUBLIC_URL",
    "uiPublicUrl": "DRIFTMOWER_UI_PUBLIC_URL",
    "authEnabled": {
      "__name": "MCP_AUTH_ENABLED",
      "__format": "boolean"
    },
    "oauthClientId": "MCP_OAUTH_CLIENT_ID"
  },
  "oidc": {
    "issuer": "OIDC_ISSUER",
    "jwksUri": "OIDC_JWKS_URI",
    "audience": "MCP_AUDIENCE",
    "namespacesClaim": "MCP_NAMESPACES_CLAIM"
  },
  "backend": {
    "enabled": {
      "__name": "DRIFTMOWER_BE_ENABLED",
      "__format": "boolean"
    },
    "url": "DRIFTMOWER_BE_URL",
    "serviceToken": "DRIFTMOWER_BE_SERVICE_TOKEN",
    "timeoutMs": {
      "__name": "DRIFTMOWER_BE_TIMEOUT_MS",
      "__format": "number"
    }
  },
  "provisioning": {
    "driftmowerUiUrl": "DRIFTMOWER_UI_URL",
    "requestTimeoutMs": {
      "__name": "DRIFTMOWER_UI_TIMEOUT_MS",
      "__format": "number"
    }
  },
  "search": {
    "defaultLimit": {
      "__name": "DRIFTMOWER_MCP_DEFAULT_LIMIT",
      "__format": "number"
    },
    "maximumLimit": {
      "__name": "DRIFTMOWER_MCP_MAX_LIMIT",
      "__format": "number"
    }
  },
  "observability": {
    "enabled": {
      "__name": "OBSERVABILITY_ENABLED",
      "__format": "boolean"
    },
    "prometheusUrl": "PROMETHEUS_URL",
    "lokiUrl": "LOKI_URL",
    "requestTimeoutMs": {
      "__name": "OBSERVABILITY_TIMEOUT_MS",
      "__format": "number"
    }
  },
  "kubernetes": {
    "url": "KUBERNETES_API_URL",
    "tokenFile": "KUBERNETES_TOKEN_FILE",
    "caFile": "KUBERNETES_CA_FILE",
    "usernamePrefix": "KUBERNETES_USERNAME_PREFIX",
    "groupsPrefix": "KUBERNETES_GROUPS_PREFIX",
    "namespaceRole": "KUBERNETES_NAMESPACE_ROLE",
    "requestTimeoutMs": {
      "__name": "KUBERNETES_TIMEOUT_MS",
      "__format": "number"
    }
  },
  "cluster": {
    "id": "DRIFTMOWER_CLUSTER_ID",
    "apiUrl": "KUBERNETES_PUBLIC_API_URL"
  },
  "advisory": {
    "overrideDirectory": "ENGINEERING_ADVISORY_OVERRIDE_DIR"
  }
}

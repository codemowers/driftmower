# Shared context for Skaffold/Kaniko. Never upload local credentials or build output.
.git
.agents
.codex
.aws
.build-tmp
skaffold.env
skaffold.env.*
**/node_modules
**/.next
**/.git
**/.agents
**/.codex
**/.aws
**/.build-tmp
**/out
**/coverage
**/.env
**/.env.*
**/*.log
**/*.tsbuildinfo

# Generated desktop/UI assets and local cluster reports.
ui/build
ui/scripts/*
!ui/scripts/license-data.mjs

# The UI prebuild needs only this SPDX metadata file.
ui/vendor/spdx-license-list-data/**
!ui/vendor/spdx-license-list-data/json
ui/vendor/spdx-license-list-data/json/**
!ui/vendor/spdx-license-list-data/json/licenses.json

desktop/frontend
desktop/build
/chart/cluster-values/
/scripts/promote-images.sh

# Copy to .env.local and fill in. OIDC login cannot work on localhost: the redirect
# URI is registered per cluster, so anything behind a session needs a cluster deploy.

# --- Required (the app throws without these) ---
# Random string of >=32 chars used to encrypt the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Public base URL of this app (used to build the OIDC redirect URI).
APP_BASE_URL=http://localhost:3000
# Resource indicator requested from passmower; must equal driftmower-be's OIDC_AUDIENCE.
OIDC_AUDIENCE=https://driftmower-api
# From the passmower-generated `oidc-client-driftmower-ui-owner-secrets` secret.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_IDP_URI=
# Optional overrides:
# OIDC_SCOPE=openid profile groups applications namespaces offline_access
# SESSION_COOKIE_NAME=driftmower_session

# --- Backend ---
# Default `http://driftmower-be:3030` resolves in the pod's own namespace. Set when the
# backend is elsewhere (`http://driftmower-be.<ns>.svc:3030`) or in local dev (its ingress).
BACKEND_URL=

# --- platform-manager (tenancy control plane) ---
# Base URL of the platform-manager API; leave unset to disable the Sandboxes page.
PLATFORM_MANAGER_URL=
# RFC 8707 resource indicator requested for platform-manager tokens; must equal
# platform-manager's OIDC audience.
PLATFORM_MANAGER_AUDIENCE=https://platform-manager-api

# --- driftmower-mcp (the platform's MCP gateway) ---
# driftmower-mcp serves the Provisioning page's facts. This app's
# /api/provisioning/capabilities mints an MCP-audience token from the session
# and forwards the query to this base URL. Unset = the page explains that
# driftmower-mcp is not configured.
DRIFTMOWER_MCP_URL=http://driftmower-mcp:3000
# Resource indicator for those tokens. Must equal the audience driftmower-mcp
# verifies (its MCP_AUDIENCE).
MCP_AUDIENCE=https://driftmower-mcp
# Appends the MCP resource indicator at login, which the Provisioning page and
# /api/mcp/token both need. Off by default: a resource indicator passmower
# rejects breaks *login*, not just MCP. Verify on a deployed build before enabling.
MCP_ENABLED=false
# Public URL of the gateway, used for the connection recipes on /provisioning.
MCP_PUBLIC_URL=https://driftmower-mcp.ee-lte-1.codemowers.io
# Client id of the public `driftmower-mcp` OIDCClient, shown so a client can run
# the OAuth flow itself (passmower has no dynamic client registration, so it
# cannot be discovered). Not a secret. Unset = the page omits the OAuth flow.
MCP_OIDC_CLIENT_ID=

# --- Optional features (unset = feature unavailable) ---
# Argo CD base URL; unset = no deep links on Argo-managed resources.
ARGO_URL=
# OpenAI-compatible endpoint for the Diagnosis card and the Actions card verdicts.
# No default: unset = /api/llm/pod-diagnosis and /api/llm/actions/assess answer 503.
LLM_BASE_URL=
OPENAI_API_KEY=
# llama_cpp (default) or openai, spelled as in driftmower-ai. `openai` drops the
# llama.cpp-only chat_template_kwargs and sends no temperature, because OpenAI
# rejects unknown body parameters and several of its models accept only the
# default temperature.
LLM_PROVIDER=llama_cpp
# Overrides the model id both roles ask for. Optional on llama_cpp, where the
# build's own model is the default; REQUIRED when LLM_PROVIDER=openai, since the
# id there is account-specific and the LLM routes answer 503 without it.
LLM_MODEL=
# Classic token from https://github.com/settings/tokens with every scope left unchecked
# (public data only). Release-note lookups in the Actions card: 60 requests/hour anonymous,
# 5000/hour with a token.
GITHUB_TOKEN=
# k3s | rke2 | vanilla; unset = detected from the node versions.
K8S_DISTRO=
# Shows a Restart tile on Deployments and StatefulSets that no other object owns,
# doing the same as `kubectl rollout restart`. Off unless exactly "true". Needs
# `patch` on deployments and statefulsets in the service account's RBAC.
WORKLOAD_RESTART_ENABLED=false

# --- Local dev only (IGNORED in-cluster, where both targets are hardwired) ---
# Unset outside a cluster: the /cluster metrics cards stay hidden.
PROMETHEUS_URL=
# Unset outside a cluster: pod logs fall back to the Kube API.
# Loki has no Ingress: kubectl port-forward svc/loki -n monitoring 3100
LOKI_URL=

# --- Rarely needed (non-standard labels, mirrors, air-gapped clusters); defaults shown ---
# Label selector matching netstatd's own pods; the server streams from every pod it matches.
# NETSTATD_LABEL_SELECTOR=app=netstatd
# ENDOFLIFE_BASE_URL=https://endoflife.date/api/v1/products
# ARTIFACT_HUB_BASE_URL=https://artifacthub.io/api/v1
# K8S_VERSION_STABLE_URL=https://dl.k8s.io/release/stable.txt
# K8S_VERSION_LATEST_URL=https://dl.k8s.io/release/latest.txt
# K8S_VERSION_CHANNELS_URL_K3S=https://update.k3s.io/v1-release/channels
# K8S_VERSION_CHANNELS_URL_RKE2=https://update.rke2.io/v1-release/channels

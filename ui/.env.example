# Copy to .env.local and fill in. OIDC login cannot work on localhost: the redirect
# URI is registered per cluster, so anything behind a session needs a cluster deploy.

# --- Required (the app throws without these) ---
# Random string of >=32 chars used to encrypt the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Public base URL of this app (used to build the OIDC redirect URI).
APP_BASE_URL=http://localhost:3000
# Resource indicator requested from passmower; must equal driftmower-be's OIDC_AUDIENCE.
OIDC_AUDIENCE=https://driftmower-api
# From the passmower-generated `oidc-client-driftmower-ui-owner-secrets` secret.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_IDP_URI=
# Optional overrides:
# OIDC_SCOPE=openid profile groups applications namespaces offline_access
# SESSION_COOKIE_NAME=driftmower_session

# --- Backend ---
# Default `http://driftmower-be:3030` resolves in the pod's own namespace. Set when the
# backend is elsewhere (`http://driftmower-be.<ns>.svc:3030`) or in local dev (its ingress).
BACKEND_URL=

# --- platform-manager (tenancy control plane) ---
# Base URL of the platform-manager API; leave unset to disable the Tenants page.
PLATFORM_MANAGER_URL=
# RFC 8707 resource indicator requested for platform-manager tokens; must equal
# platform-manager's OIDC audience.
PLATFORM_MANAGER_AUDIENCE=https://platform-manager-api

# --- Optional features (unset = feature unavailable) ---
# Manual override; in-cluster the netstatd Ingress is auto-discovered (label app=netstatd).
NETSTATD_URL=
# Argo CD base URL; unset = no deep links on Argo-managed resources.
ARGO_URL=
# OpenAI-compatible endpoint for the AI summaries. No default: unset = /api/llm 503s.
LLM_BASE_URL=
OPENAI_API_KEY=
# Classic token from https://github.com/settings/tokens with every scope left unchecked
# (public data only). Release-note lookups in the Actions card: 60 requests/hour anonymous,
# 5000/hour with a token.
GITHUB_TOKEN=
# k3s | rke2 | vanilla; unset = detected from the node versions.
K8S_DISTRO=

# --- Local dev only (IGNORED in-cluster, where both targets are hardwired) ---
# Unset outside a cluster: the /cluster metrics cards stay hidden.
PROMETHEUS_URL=
# Unset outside a cluster: pod logs fall back to the Kube API.
# Loki has no Ingress: kubectl port-forward svc/loki -n monitoring 3100
LOKI_URL=

# --- Rarely needed (mirrors, air-gapped clusters); defaults shown ---
# ENDOFLIFE_BASE_URL=https://endoflife.date/api/v1/products
# ARTIFACT_HUB_BASE_URL=https://artifacthub.io/api/v1
# K8S_VERSION_STABLE_URL=https://dl.k8s.io/release/stable.txt
# K8S_VERSION_LATEST_URL=https://dl.k8s.io/release/latest.txt
# K8S_VERSION_CHANNELS_URL_K3S=https://update.k3s.io/v1-release/channels
# K8S_VERSION_CHANNELS_URL_RKE2=https://update.rke2.io/v1-release/channels
